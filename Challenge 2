#include <kipr/wombat.h>
// DECLARE FUNCTIONS
void backward();
void turnleft(); 
void turnright();

// DECLARE VARIABLES
int red = 2;  //channel 2 is red
int lmotor = 2;
int rmotor = 0;
int lspeed = 20;
int rspeed = 40;
int ctime = 10; 
int ptime = 100;

int main()
{
    camera_open_black();    // open the camera
    camera_update(); //update camera feed
    msleep(ptime);	//wait 100 milliseconds
	while(analog(0)<2830)  //while the object is not close to the robot
        {
         camera_update();
        	
            if(get_object_count(red) >=4)  //if there is a red object on the screen 
            {
               	if(get_object_center_x(red, 0) <=125)  
               	{
                    turnleft();
                    msleep(ctime);  //turn left for 10 milliseconds 
                    printf("turnleft \n"); 
                    camera_update(); 
                    msleep(ctime);  //wait 10 millisecounds 
                }
                if(get_object_center_x(red, 0) >126)
                {
                	turnright(); 
                    msleep(ctime); //turn right for 10 milliseconds 
                    printf("turnright \n");
                    camera_update(); 
                    msleep(ctime);  //wait 10 millisecounds
                }
                                		
            }
        else  //if there is no red on the screen 
        {
            ao();  //stop
        }
           
        }
    
    camera_close(); // close the camera

    return 0;
}


void turnleft()
{
    motor(rmotor,rspeed);  //right motor 40% power
    motor(lmotor,lspeed);  //left motor 20% power
} 
   
                   
void turnright()
{
    motor(rmotor, lspeed);  //right motor 20% power
    motor(lmotor, rspeed);  //left motor 40% power
}
